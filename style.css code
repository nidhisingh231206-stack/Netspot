* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f7fb;
    color: #172033;
    display: flex;
}


/* SIDEBAR */

.sidebar {
    width: 240px;
    height: 100vh;
    background: #101827;
    color: white;
    padding: 25px 18px;
    position: fixed;
    left: 0;
    top: 0;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 45px;
}

.logo-icon {
    width: 42px;
    height: 42px;
    background: #2563eb;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.logo h2 {
    font-size: 21px;
}

.logo span {
    font-size: 11px;
    color: #9ca3af;
}


nav a {
    display: flex;
    gap: 14px;
    padding: 13px 14px;
    margin: 7px 0;
    border-radius: 9px;
    color: #aeb8c8;
    cursor: pointer;
}

nav a:hover,
nav .active {
    background: #1d4ed8;
    color: white;
}

.sidebar-bottom {
    position: absolute;
    bottom: 35px;
}

.sidebar-bottom p {
    color: #8994a7;
    font-size: 12px;
    margin-bottom: 8px;
}

.online {
    font-size: 12px;
}

.online span {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    margin-right: 5px;
}


/* MAIN */

.main {
    margin-left: 240px;
    width: calc(100% - 240px);
    padding: 30px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.topbar h1 {
    font-size: 26px;
}

.topbar p {
    color: #7b8495;
    margin-top: 5px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 20px;
}

.avatar {
    width: 38px;
    height: 38px;
    background: #2563eb;
    color: white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
}


/* STAT CARDS */

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 20px;
}

.stat-card {
    background: white;
    padding: 20px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
}

.stat-card p {
    font-size: 13px;
    color: #7c8798;
    margin-bottom: 5px;
}

.stat-card h2 {
    font-size: 22px;
}

.stat-icon {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.blue {
    background: #e0ecff;
}

.green {
    background: #dcfce7;
}

.purple {
    background: #ede9fe;
}

.orange {
    background: #ffedd5;
}

.green-text {
    color: #16a34a;
    font-size: 12px;
}


/* CARDS */

.card {
    background: white;
    border-radius: 15px;
    padding: 22px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.card-header h2 {
    font-size: 18px;
}

.card-header p {
    color: #8892a3;
    font-size: 12px;
    margin-top: 4px;
}


/* MAP */

.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.map {
    height: 380px;
    background: #e9f0f7;
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    background-image:
        linear-gradient(#d4dde8 1px, transparent 1px),
        linear-gradient(90deg, #d4dde8 1px, transparent 1px);
    background-size: 40px 40px;
}

.building {
    position: absolute;
    padding: 14px;
    border-radius: 10px;
    color: #172033;
    box-shadow: 0 4px 10px rgba(0,0,0,0.12);
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.building span {
    font-size: 11px;
}

.library {
    background: #bbf7d0;
    left: 12%;
    top: 15%;
}

.block-a {
    background: #bbf7d0;
    left: 43%;
    top: 13%;
}

.block-b {
    background: #fef08a;
    right: 10%;
    top: 18%;
}

.canteen {
    background: #fecaca;
    left: 18%;
    bottom: 15%;
}

.lab {
    background: #bbf7d0;
    left: 52%;
    bottom: 15%;
}

.hostel {
    background: #fecaca;
    right: 8%;
    bottom: 12%;
}

.legend {
    display: flex;
    gap: 20px;
    margin-top: 15px;
    font-size: 12px;
}

.legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 5px;
}

.legend .green {
    background: #22c55e;
}

.legend .yellow {
    background: #eab308;
}

.legend .red {
    background: #ef4444;
}


/* BUTTON */

.scan-btn {
    border: none;
    background: #2563eb;
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
    cursor: pointer;
}

.scan-btn:hover {
    background: #1d4ed8;
}


/* NETWORK */

.connected {
    color: #16a34a;
    font-size: 11px;
}

.wifi-name {
    display: flex;
    gap: 15px;
    align-items: center;
    padding: 18px;
    background: #f3f7ff;
    border-radius: 10px;
    margin-bottom: 18px;
}

.wifi-name h3 {
    margin-bottom: 4px;
}

.wifi-name p {
    font-size: 12px;
    color: #8993a3;
}

.network-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.network-details div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.network-details span {
    color: #8993a3;
    font-size: 11px;
}

.network-details strong {
    font-size: 14px;
}


/* ANALYTICS */

.analytics {
    margin-top: 20px;
}

.analytics select {
    padding: 8px 12px;
    border: 1px solid #d8dee8;
    border-radius: 7px;
}


/* BOTTOM */

.bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
}

.alert {
    display: flex;
    gap: 12px;
    padding: 13px;
    background: #fff7f7;
    border-radius: 8px;
    margin-top: 10px;
}

.alert p {
    font-size: 12px;
    color: #7c8798;
    margin-top: 4px;
}

.coverage {
    display: flex;
    justify-content: space-around;
    text-align: center;
}

.coverage div {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.coverage strong {
    font-size: 24px;
}

.coverage span {
    font-size: 11px;
    color: #7c8798;
}


/* RESPONSIVE */

@media(max-width: 1000px) {

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 700px) {

    .sidebar {
        width: 70px;
    }

    .sidebar span,
    .logo div:not(.logo-icon),
    .sidebar-bottom {
        display: none;
    }

    .main {
        margin-left: 70px;
        width: calc(100% - 70px);
        padding: 15px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .bottom-grid {
        grid-template-columns: 1fr;
    }
}
